// E3 — fixtures carry the mandatory CloudEvents envelope invariants.
func TestCloudEventsEnvelopeInvariants(t *testing.T) {
	for _, fixture := range []string{"testdata/{{EVENT_NAME}}.cloudevent.json"} {
		raw := readFixture(t, fixture)
		var env struct {
			SpecVersion     string `json:"specversion"`
			ID              string `json:"id"`
			Source          string `json:"source"`
			Type            string `json:"type"`
			Subject         string `json:"subject"`
			Time            string `json:"time"`
			DataContentType string `json:"datacontenttype"`
			DataSchema      string `json:"dataschema"`
		}
		if err := json.Unmarshal(raw, &env); err != nil {
			t.Fatalf("%s: %v", fixture, err)
		}
		if env.SpecVersion != "1.0" {
			t.Errorf("%s: specversion = %q, want 1.0", fixture, env.SpecVersion)
		}
		for _, pair := range [][2]string{
			{"id", env.ID}, {"source", env.Source}, {"type", env.Type},
			{"subject", env.Subject}, {"time", env.Time},
			{"datacontenttype", env.DataContentType}, {"dataschema", env.DataSchema},
		} {
			if pair[1] == "" {
				t.Errorf("%s: mandatory attribute %q is empty", fixture, pair[0])
			}
		}
		// The dataschema urn names the producer: urn:warehouse:<producer>:...
		// (retail-network: urn:retailnetwork:<context>:...).
		if !strings.HasPrefix(env.DataSchema, "urn:warehouse:{{PRODUCER}}:") &&
			!strings.HasPrefix(env.DataSchema, "urn:retailnetwork:{{CONTEXT}}:") {
			t.Errorf("%s: dataschema %q does not name the producer", fixture, env.DataSchema)
		}
		// The wire carries content-type application/cloudevents+json; assert
		// it wherever the repo's test doubles record Kafka headers.
		// SEARCH-FOR: headers.Get("content-type") == "application/cloudevents+json".
	}
}

// E4 — extra data keys must not break the decoder; unknown dataschema
// versions route to the repo's documented DLQ policy (if any).
func TestUnknownAttributesTolerated(t *testing.T) {
	t.Run("extra data keys are ignored", func(t *testing.T) {
		raw := readFixture(t, "testdata/{{EVENT_NAME}}.cloudevent.json")
		var env map[string]any
		if err := json.Unmarshal(raw, &env); err != nil {
			t.Fatal(err)
		}
		env["data"].(map[string]any)["aFieldThisVersionDoesNotKnow"] = "forward compatibility"
		perturbed, _ := json.Marshal(env)
		// SEARCH-FOR: the SAME real decode path as E2 must succeed — unknown
		// keys are ignored, per every consumed-topic description in the fleet.
		var v map[string]any
		if err := json.Unmarshal(perturbed, &v); err != nil {
			t.Fatalf("decoder broke on an extra data key: %v", err)
		}
	})

	t.Run("unknown dataschema version follows the DLQ policy", func(t *testing.T) {
		raw := readFixture(t, "testdata/{{EVENT_NAME}}.cloudevent.json")
		var env map[string]any
		if err := json.Unmarshal(raw, &env); err != nil {
			t.Fatal(err)
		}
		env["dataschema"] = strings.Replace(env["dataschema"].(string), ":v1", ":v999", 1)
		perturbed, _ := json.Marshal(env)
		_ = perturbed
		// SEARCH-FOR: assert the repo's DOCUMENTED policy for an
		// unimplemented dataschema version — skip-and-commit, dead-letter to
		// <topic>.dlq, or dead-letter-at-once. What is never allowed:
		// crashing, blocking the partition, or applying the payload anyway.
		// If the repo documents no DLQ policy, assert the documented skip
		// behaviour and cite its ADR here.
	})
}
