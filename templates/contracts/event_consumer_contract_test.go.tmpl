// only — NO other new dependencies. The pinned copy lives at
// testdata/{{PRODUCER}}.asyncapi.yaml and is listed in contracts/pinned.json.
//
// CRITICAL CONVENTION (docs/contract-testing.md): the fleet's asyncapi.yaml
// files use CHANNEL-PERSPECTIVE operations, inverted from the AsyncAPI 2.6
// app perspective. A producer's OWN topics are documented under 'subscribe:'
// (the app publishes; written by the outbox relay); topics it CONSUMES from
// others are under 'publish:' (tagged 'consumed'). To find what a producer
// PRODUCES in a 2.6 spec, read its 'subscribe:' operations. Retail-network
// specs are 3.0.0: the equivalent is 'action: send' operations (consumed
// topics are 'action: receive' tagged 'consumed').
package {{PRODUCER}}_consumer_test

import (
	"encoding/json"
	"strings"
	"testing"

	"gopkg.in/yaml.v3"
)

// pinnedAsyncAPI is the minimal shape of the producer's pinned spec this kit
// needs: channels, and whether each channel is one the producer PRODUCES.
type pinnedAsyncAPI struct {
	AsyncAPI  string `yaml:"asyncapi"`
	Channels  map[string]struct {
		Address   string `yaml:"address"`
		Subscribe *struct { // 2.6: present => the producer's OWN topic (channel perspective!)
			OperationID string `yaml:"operationId"`
			Message     *any   `yaml:"message"`
		} `yaml:"subscribe"`
		Publish *struct { // 2.6: present => a topic the PRODUCER consumes from someone else
			OperationID string `yaml:"operationId"`
		} `yaml:"publish"`
	} `yaml:"channels"`
	Operations map[string]struct { // 3.0: send => the producer's OWN topic
		Action  string `yaml:"action"`
		Channel any    `yaml:"channel"`
	} `yaml:"operations"`
}

func loadPinnedAsyncAPI(t *testing.T) pinnedAsyncAPI {
	t.Helper()
	raw, err := readFile("testdata/{{PRODUCER}}.asyncapi.yaml") // SEARCH-FOR: os.ReadFile or your test helper.
	if err != nil {
		t.Fatal(err)
	}
	var spec pinnedAsyncAPI
	if err := yaml.Unmarshal(raw, &spec); err != nil {
		t.Fatalf("pinned asyncapi does not parse: %v", err)
	}
	return spec
}

// producedChannels returns the channels the producer writes to, honouring the
// channel-perspective convention: 2.6 'subscribe:' (sic) and 3.0 'action: send'.
func producedChannels(t *testing.T, spec pinnedAsyncAPI) map[string][]string {
	t.Helper()
	out := map[string][]string{}
	if strings.HasPrefix(spec.AsyncAPI, "3.") {
		// 3.0: map each send operation to its channel's address via the $ref.
		for name, op := range spec.Operations {
			if op.Action != "send" {
				continue // 'receive' + tag 'consumed' = topics the PRODUCER consumes.
			}
			ref := refString(op.Channel) // SEARCH-FOR: op.Channel is '#/channels/<name>'; resolve it.
			if addr, ok := channelAddress(spec, ref); ok {
				out[addr] = append(out[addr], name)
			}
		}
		return out
	}
	// 2.6 channel perspective: OWN topic <=> the channel has a 'subscribe' op.
	for _, ch := range spec.Channels {
		if ch.Subscribe != nil && ch.Subscribe.OperationID != "" {
			out[ch.Address] = nil
		}
	}
	return out
}

// E1 — every topic this repo's Kafka reader subscribes to appears as a
// produced channel in the producer's pinned asyncapi.
func TestPinnedAsyncAPICoversSubscriptions(t *testing.T) {
	produced := producedChannels(t, loadPinnedAsyncAPI(t))
	subscribed := []string{
		// SEARCH-FOR: every topic string the repo's reader configuration names
		// (grep the consumer-group setup / env defaults, not your memory).
		"wms.{{PRODUCER}}.events",
	}
	for _, topic := range subscribed {
		if _, ok := produced[topic]; !ok {
			t.Errorf("reader subscribes to %q but the producer's pinned spec does not produce it (remember: own topics live under 'subscribe:' / action: send)", topic)
		}
	}
}

